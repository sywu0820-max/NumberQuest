  "schemaVersion": "1.0.0",
  "graphId": "tw-grade-2a-foundation",
  "title": "Taiwan Grade 2 first-semester mathematics foundation",
  "status": "planning-only",
  "runtimeIntegration": false,
  "scopePolicy": {
    "commonGraph": true,
    "publisherLayersAreChildFacing": false,
    "schoolProgressMayAffectSurfacingOnly": true,
    "masteryControlsProgression": true,
    "questionBankIncluded": false
  },
  "curriculumCodes": {
    "N-2-1": "Place value and representation of whole numbers within 1000",
    "N-2-2": "Addition/subtraction notation and vertical calculation grounded in place value",
    "N-2-3": "Addition/subtraction application problems and unknown quantities",
    "N-2-6": "Meaning and application of multiplication, including language of times-as-many",
    "N-2-7": "Multiplication facts through 9 x 9",
    "N-2-8": "Two-step application problems",
    "N-2-11": "Length in centimetres and metres through measuring, estimating and calculating",
    "N-2-12": "Capacity, weight and area comparison through hands-on activity",
    "N-2-13": "Clock time in hours and minutes",
    "R-2-1": "Greater-than/less-than relations and transitive comparison",
    "R-2-3": "Commutative relationship of multiplication",
    "R-2-4": "Relationship between addition and subtraction",
    "S-2-1": "Observable features of simple plane and solid shapes",
    "S-2-2": "Recognize, describe and classify simple plane and solid shapes"
  },
  "pedagogyCatalog": {
    "hintStrategies": {
      "place-value-build": ["show hundreds, tens and ones as movable bundles", "name the place that changes", "return control before choosing an answer"],
      "compare-align": ["align representations by hundreds, tens and ones", "compare the highest differing place", "avoid revealing the final symbol"],
      "regroup-model": ["build both quantities with base-ten objects", "exchange one ten for ten ones or ten ones for one ten", "rebuild the vertical notation from the exchange"],
      "relationship-model": ["identify what is known and unknown in the story", "act out or diagram the relationship", "offer a choice of operation with a reason prompt"],
      "measure-anchor": ["anchor the start point and unit", "trace equal unit intervals", "ask the child to estimate before remeasuring"],
      "multiplication-groups": ["construct equal groups or an array", "connect groups to repeated addition", "derive a nearby fact instead of stating the product"],
      "clock-trace": ["identify the minute and hour hands", "trace minute marks from 12", "check how the hour hand moves between hours"],
      "compare-physical": ["choose direct comparison, an intermediary, or equal units", "keep the comparison unit unchanged", "ask the child to explain the evidence"],
      "shape-inspect": ["trace edges, corners, boundary or surface", "rotate or rearrange the object", "classify by properties rather than orientation"]
    },
    "retryStrategies": {
      "isomorphic-new-surface": "Retry the same mathematical relationship with new quantities or a new surface representation; never repeat the identical prompt as punishment.",
      "concrete-then-symbolic": "Step back to manipulable or visual objects, then return to a fresh symbolic instance after the child acts.",
      "contrast-case": "Offer two carefully contrasted cases that isolate the misconception, then retry with a third case.",
      "strategy-choice": "Let the child choose between two answer-safe strategies, then retry independently on a fresh instance."
    },
    "masteryProfiles": {
      "concept": {
        "acquisition": "At least 3 independent successes across 2 representations; hinted success is recovery evidence, not independent mastery.",
        "retrieval": "At least 1 successful next-session revisit and 1 later successful revisit after 3 or more days.",
        "transfer": "At least 2 first-try successes in distinct surface contexts or representations.",
        "missPolicy": "A miss schedules support and review but never erases earned evidence or rewards."
      },
      "calculation": {
        "acquisition": "At least 4 independent accurate calculations including boundary and regrouping-sensitive cases.",
        "retrieval": "Successful independent calculations in a later session and again after 3 or more days.",
        "transfer": "At least 2 correct applications outside bare vertical-form prompts.",
        "missPolicy": "Record the error pattern for hint selection; do not label the child or reset prior mastery."
      },
      "application": {
        "acquisition": "At least 3 independent solutions across distinct relationship families, including an explanation or valid model.",
        "retrieval": "A later-session problem must be solved without an operation cue.",
        "transfer": "At least 2 independent successes after changing story theme and representation while preserving the relationship.",
        "missPolicy": "Separate language/model support from calculation support so the retry targets the actual difficulty."
      },
      "measurement": {
        "acquisition": "At least 3 independent observations or measurements using correct units and procedure.",
        "retrieval": "A later-session task must be completed without procedural highlighting.",
        "transfer": "At least 2 successes using different objects, orientations, scales or comparison methods.",
        "missPolicy": "Return to an observable anchor or manipulable comparison; do not reveal a numeric result."
      },
      "fact-family": {
        "acquisition": "Accurate independent use across at least 4 varied facts in the family, with at least 2 represented as groups, arrays or stories.",
        "retrieval": "Retrieve varied facts in later sessions without a timer requirement.",
        "transfer": "Use the family in at least 2 distinct multiplication situations and derive at least 1 related fact.",
        "missPolicy": "Use a known-fact strategy and revisit later; speed is never evidence of understanding by itself."
      }
    },
    "reviewProfiles": {
      "standard": {"sameSession": "after 2-4 intervening items", "crossSession": ["1-2 days", "4-7 days", "14-21 days"], "variation": "change representation before increasing magnitude"},
      "application-varied": {"sameSession": "one fresh relationship-preserving story", "crossSession": ["1-2 days", "5-8 days", "14-21 days"], "variation": "rotate story theme, unknown position and representation"},
      "fact-distributed": {"sameSession": "mix with a known and a neighboring fact family", "crossSession": ["next session", "3-5 days", "10-14 days", "21-30 days"], "variation": "mix order, groups, arrays and untimed retrieval"},
      "hands-on-return": {"sameSession": "one changed object or orientation", "crossSession": ["2-3 days", "7-10 days", "21-30 days"], "variation": "alternate direct, indirect and unit-based evidence where applicable"}
    },
    "misconceptions": {
      "pv-count-digits": "Treats a numeral as separate digits rather than hundreds, tens and ones.",
      "pv-zero-placeholder": "Ignores zero as a place holder.",
      "pv-compare-length": "Chooses by a salient digit instead of the highest differing place.",
      "add-align": "Misaligns ones and tens in vertical form.",
      "add-carry-value": "Carries a 1 without understanding it represents one ten.",
      "sub-direction": "Always subtracts the smaller visible digit from the larger digit.",
      "sub-borrow-value": "Borrows a 1 without exchanging one ten for ten ones.",
      "op-keyword": "Chooses an operation from one keyword without modeling the relationship.",
      "unknown-position": "Assumes the answer is always the final quantity in the sentence.",
      "inverse-surface": "Knows separate facts but does not recognize addition and subtraction as inverse relations.",
      "two-step-stop": "Stops after the first valid calculation.",
      "two-step-order": "Calculates in sentence order without considering dependencies.",
      "cm-count-marks": "Counts ruler marks instead of intervals.",
      "cm-start-zero": "Assumes measurement must start at the ruler edge rather than subtracting scale positions.",
      "cm-unit-mix": "Compares or combines lengths without preserving units.",
      "mul-unequal-groups": "Calls any collection of groups multiplication even when group sizes differ.",
      "mul-factor-roles": "Confuses number of groups with objects per group and cannot explain either factor.",
      "mul-add-factors": "Adds the two factors instead of using equal groups.",
      "mul-order-language": "Treats reversed factors as the same story role even though the product is equal.",
      "clock-hand-swap": "Swaps the hour and minute hands.",
      "clock-hour-drift": "Reads the hour hand as the next hour after it has moved between numerals.",
      "clock-five-vs-one": "Counts hour numerals as single minutes rather than groups of five minute marks.",
      "compare-container-shape": "Judges capacity from height or width alone.",
      "weight-size": "Assumes the larger-looking object is always heavier.",
      "area-perimeter": "Judges surface size only from boundary length or shape outline.",
      "area-unit-gaps": "Uses overlapping, gapped or unequal covering units.",
      "shape-orientation": "Believes rotating a shape changes its type.",
      "shape-feature-count": "Confuses edges, corners, boundary, inside and surface."
    }
  },
